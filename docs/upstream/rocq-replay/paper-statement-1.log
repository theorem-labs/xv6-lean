(forall (pol : bool) (env : Env), Tauto.eval_cnf eval' env (Tauto.xcnf unsat deduce normalise negate pol f2) -> Tauto.hold k (Tauto.eval_f Tauto.e_rtyp (eval env) (if pol then f2 else Tauto.NOT f2))) ->
forall (pol : bool) (env : Env), Tauto.eval_cnf eval' env (Tauto.xcnf unsat deduce normalise negate pol (Tauto.IMPL f1 o f2)) -> Tauto.hold k (Tauto.eval_f Tauto.e_rtyp (eval env) (if pol then Tauto.IMPL f1 o f2 else Tauto.NOT (Tauto.IMPL f1 o f2)))
