Znat.Nat2Z.id :
forall n : nat, BinInt.Z.to_nat (BinInt.Z.of_nat n) = n
Pnat.Nat2Pos.id :
forall n : nat, n <> 0 -> BinPos.Pos.to_nat (BinPos.Pos.of_nat n) = n
Nnat.Nat2N.id :
forall n : nat, BinNat.N.to_nat (BinNat.N.of_nat n) = n
Znat.N2Z.id :
forall n : BinNums.N, BinInt.Z.to_N (BinInt.Z.of_N n) = n
Nnat.N2Nat.id :
forall a : BinNums.N, BinNat.N.of_nat (BinNat.N.to_nat a) = a
Tauto.hold_eTT :
forall k : Tauto.kind, Tauto.hold k (Tauto.eTT k)
Tauto.hold_eOR :
forall (k : Tauto.kind) (r1 r2 : Tauto.rtyp k), Tauto.hold k (Tauto.eOR k r1 r2) <-> Tauto.hold k r1 \/ Tauto.hold k r2
Tauto.hold_eNOT :
forall (k : Tauto.kind) (e : Tauto.rtyp k), Tauto.hold k (Tauto.eNOT k e) <-> ~ Tauto.hold k e
Tauto.hold_eIMPL :
forall (k : Tauto.kind) (e1 e2 : Tauto.rtyp k), Tauto.hold k (Tauto.eIMPL k e1 e2) <-> (Tauto.hold k e1 -> Tauto.hold k e2)
Tauto.hold_eIFF_IMPL :
forall (k : Tauto.kind) (e1 e2 : Tauto.rtyp k), Tauto.hold k (Tauto.eIFF k e1 e2) <-> Tauto.hold k (Tauto.eAND k (Tauto.eIMPL k e1 e2) (Tauto.eIMPL k e2 e1))
Tauto.hold_eIFF :
forall (k : Tauto.kind) (e1 e2 : Tauto.rtyp k), Tauto.hold k (Tauto.eIFF k e1 e2) <-> (Tauto.hold k e1 <-> Tauto.hold k e2)
Tauto.hold_eFF :
forall k : Tauto.kind, Tauto.hold k (Tauto.eNOT k (Tauto.eFF k))
Tauto.hold_eEQ :
forall e1 e2 : Tauto.rtyp Tauto.isBool, Tauto.hold Tauto.isBool (Tauto.eIFF Tauto.isBool e1 e2) <-> e1 = e2
Tauto.hold_eAND :
forall (k : Tauto.kind) (r1 r2 : Tauto.rtyp k), Tauto.hold k (Tauto.eAND k r1 r2) <-> Tauto.hold k r1 /\ Tauto.hold k r2
BinInt.Z.gtb_spec :
forall n m : BinNums.Z, BoolSpec (BinInt.Z.lt m n) (BinInt.Z.le n m) (BinInt.Z.gtb n m)
BinInt.Z.gtb_ltb :
forall n m : BinNums.Z, BinInt.Z.gtb n m = BinInt.Z.ltb m n
BinInt.Z.gtb_lt :
forall n m : BinNums.Z, BinInt.Z.gtb n m = true <-> BinInt.Z.lt m n
BinInt.Z.gtb_gt :
forall n m : BinNums.Z, BinInt.Z.gtb n m = true <-> BinInt.Z.gt n m
BinInt.Z.gt_wf :
forall z : BinNums.Z, well_founded (fun n m : BinNums.Z => BinInt.Z.lt m n /\ BinInt.Z.le n z)
BinInt.Z.gt_lt_iff :
forall n m : BinNums.Z, BinInt.Z.gt n m <-> BinInt.Z.lt m n
BinPos.Pos.gt_lt_iff :
forall p q : BinNums.positive, BinPos.Pos.gt p q <-> BinPos.Pos.lt q p
BinInt.Z.gt_lt :
forall n m : BinNums.Z, BinInt.Z.gt n m -> BinInt.Z.lt m n
BinPos.Pos.gt_lt :
forall p q : BinNums.positive, BinPos.Pos.gt p q -> BinPos.Pos.lt q p
