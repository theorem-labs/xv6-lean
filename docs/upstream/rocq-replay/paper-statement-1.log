BinInt.Z.le BinNums.Z0 r1 /\ BinInt.Z.lt r1 b \/ BinInt.Z.lt b r1 /\ BinInt.Z.le r1 BinNums.Z0 -> BinInt.Z.le BinNums.Z0 r2 /\ BinInt.Z.lt r2 b \/ BinInt.Z.lt b r2 /\ BinInt.Z.le r2 BinNums.Z0 -> BinInt.Z.add (BinInt.Z.mul b q1) r1 = BinInt.Z.add (BinInt.Z.mul b q2) r2 -> q1 = q2 /\ r1 = r2
BinInt.Z.Private_NZDiv.div_mod_unique :
forall b q1 q2 r1 r2 : BinNums.Z, BinInt.Z.le BinNums.Z0 r1 /\ BinInt.Z.lt r1 b -> BinInt.Z.le BinNums.Z0 r2 /\ BinInt.Z.lt r2 b -> BinInt.Z.add (BinInt.Z.mul b q1) r1 = BinInt.Z.add (BinInt.Z.mul b q2) r2 -> q1 = q2 /\ r1 = r2
BinInt.Z.div_mod :
forall a b : BinNums.Z, b <> BinNums.Z0 -> a = BinInt.Z.add (BinInt.Z.mul b (BinInt.Z.div a b)) (BinInt.Z.modulo a b)
BinInt.Z.div_lt_upper_bound :
forall a b q : BinNums.Z, BinInt.Z.lt BinNums.Z0 b -> BinInt.Z.lt a (BinInt.Z.mul b q) -> BinInt.Z.lt (BinInt.Z.div a b) q
BinInt.Z.div_le_upper_bound :
forall a b q : BinNums.Z, BinInt.Z.lt BinNums.Z0 b -> BinInt.Z.le a (BinInt.Z.mul b q) -> BinInt.Z.le (BinInt.Z.div a b) q
BinInt.Z.div_le_mono :
forall a b c : BinNums.Z, BinInt.Z.lt BinNums.Z0 c -> BinInt.Z.le a b -> BinInt.Z.le (BinInt.Z.div a c) (BinInt.Z.div b c)
BinInt.Z.div_exact :
forall a b : BinNums.Z, b <> BinNums.Z0 -> a = BinInt.Z.mul b (BinInt.Z.div a b) <-> BinInt.Z.modulo a b = BinNums.Z0
BinInt.Z.div_eucl_eq :
forall a b : BinNums.Z, b <> BinNums.Z0 -> let (q, r) := BinInt.Z.div_eucl a b in a = BinInt.Z.add (BinInt.Z.mul b q) r
BinInt.Z.div_div :
forall a b c : BinNums.Z, b <> BinNums.Z0 -> BinInt.Z.lt BinNums.Z0 c -> BinInt.Z.div (BinInt.Z.div a b) c = BinInt.Z.div a (BinInt.Z.mul b c)
BinInt.Z.div_add :
forall a b c : BinNums.Z, c <> BinNums.Z0 -> BinInt.Z.div (BinInt.Z.add a (BinInt.Z.mul b c)) c = BinInt.Z.add (BinInt.Z.div a c) b
BinInt.Z.div_1_r :
forall a : BinNums.Z, BinInt.Z.div a (BinNums.Zpos BinNums.xH) = a
BinInt.Z.div_0_l :
forall a : BinNums.Z, a <> BinNums.Z0 -> BinInt.Z.div BinNums.Z0 a = BinNums.Z0
BinInt.Z.Private_NZDiv.div_0_l :
forall a : BinNums.Z, BinInt.Z.lt BinNums.Z0 a -> BinInt.Z.div BinNums.Z0 a = BinNums.Z0
