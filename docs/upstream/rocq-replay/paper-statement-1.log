BinList.jump_tl :
forall (A : Type) (j : BinNums.positive) (l : list A), List.tl (BinList.jump j l) = BinList.jump j (List.tl l)
BinList.jump_succ :
forall (A : Type) (j : BinNums.positive) (l : list A), BinList.jump (BinPos.Pos.succ j) l = BinList.jump BinNums.xH (BinList.jump j l)
Env.jump_simpl :
forall (D : Type) (p : BinNums.positive) (l : Env.Env D) (x : BinNums.positive), Env.jump p l x = match p with
                                                                                                  | BinNums.xI p0 => Env.jump p0 (Env.jump p0 (Env.tail l)) x
                                                                                                  | BinNums.xO p0 => Env.jump p0 (Env.jump p0 l) x
                                                                                                  | BinNums.xH => Env.tail l x
                                                                                                  end
Env.jump_pred_double :
forall (D : Type) (i : BinNums.positive) (l : Env.Env D) (x : BinNums.positive), Env.jump (BinPos.Pos.pred_double i) (Env.tail l) x = Env.jump i (Env.jump i l) x
BinList.jump_pred_double :
