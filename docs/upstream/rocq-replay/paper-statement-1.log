(forall (n : S1) (m : S2), I3 (Op n m) = TBOP (I1 n) (I2 m)) -> forall (s1 : S1) (t1 : T1), I1 s1 = t1 -> forall (s2 : S2) (t2 : T2), I2 s2 = t2 -> I3 (Op s1 s2) = TBOP t1 t2
