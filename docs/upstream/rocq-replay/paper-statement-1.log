gmap.gmap_dep_partial_alter_GNode :
forall (A : Type) (P : BinNums.positive -> Prop) (f : option A -> option A) (i : BinNums.positive) (p : P i) (ml : gmap.gmap_dep A (fun p0 : BinNums.positive => P (BinNums.xO p0))) (mx : option (P BinNums.xH * A)) (mr : gmap.gmap_dep A (fun p0 : BinNums.positive => P (BinNums.xI p0))),
gmap.GNode_valid ml mx mr ->
gmap.gmap_dep_partial_alter f i p (gmap.GNode ml mx mr) =
match i as i0 return (P i0 -> gmap.gmap_dep A P) with
| BinNums.xI i0 => fun p0 : (fun p0 : BinNums.positive => P (BinNums.xI p0)) i0 => gmap.GNode ml mx (gmap.gmap_dep_partial_alter f i0 p0 mr)
| BinNums.xO i0 => fun p0 : P (BinNums.xO i0) => gmap.GNode (gmap.gmap_dep_partial_alter f i0 p0 ml) mx mr
| BinNums.xH => fun p0 : P BinNums.xH => gmap.GNode ml (base.fmap (pair p0) (f (base.fmap snd mx))) mr
end p
gmap.gmap_dep_omap_GNode :
forall (A B : Type) (P : BinNums.positive -> Prop) (f : A -> option B) (ml : gmap.gmap_dep A (fun p : BinNums.positive => P (BinNums.xO p))) (mx : option (P BinNums.xH * A)) (mr : gmap.gmap_dep A (fun p : BinNums.positive => P (BinNums.xI p))),
gmap.GNode_valid ml mx mr -> gmap.gmap_dep_omap f (gmap.GNode ml mx mr) = gmap.GNode (gmap.gmap_dep_omap f ml) (base.mbind (fun '(p, x) => base.fmap (pair p) (f x)) mx) (gmap.gmap_dep_omap f mr)
