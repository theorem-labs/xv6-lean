BinPos.Pos.iter_swap_gen :
forall (A B : Type) (f : A -> B) (g : A -> A) (h : B -> B), (forall a : A, f (g a) = h (f a)) -> forall (p : BinNums.positive) (a : A), f (BinPos.Pos.iter g a p) = BinPos.Pos.iter h (f a) p
BinPos.Pos.iter_swap :
forall (p : BinNums.positive) (A : Type) (f : A -> A) (x : A), BinPos.Pos.iter f (f x) p = f (BinPos.Pos.iter f x p)
BinPos.Pos.iter_succ :
forall (p : BinNums.positive) (A : Type) (f : A -> A) (x : A), BinPos.Pos.iter f x (BinPos.Pos.succ p) = f (BinPos.Pos.iter f x p)
BinPos.Pos.iter_op_succ :
forall (A : Type) (op : A -> A -> A), (forall x y z : A, op x (op y z) = op (op x y) z) -> forall (p : BinNums.positive) (a : A), BinPos.Pos.iter_op op (BinPos.Pos.succ p) a = op a (BinPos.Pos.iter_op op p a)
BinPos.Pos.iter_invariant :
forall (p : BinNums.positive) (A : Type) (f : A -> A) (Inv : A -> Prop), (forall x : A, Inv x -> Inv (f x)) -> forall x : A, Inv x -> Inv (BinPos.Pos.iter f x p)
BinPos.Pos.iter_ind :
