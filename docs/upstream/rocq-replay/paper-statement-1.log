countable.N_countable_obligation_1 :
forall x : BinNums.N,
(if
  base.decide
    ((let program_branch_0 := fun _ : BinNums.N0 = x => BinNums.xH in
      let program_branch_1 := fun (p : BinNums.positive) (_ : BinNums.Npos p = x) => BinPos.Pos.succ p in match x as x' return (x' = x -> BinNums.positive) with
                                                                                                          | BinNums.N0 => program_branch_0
                                                                                                          | BinNums.Npos p => program_branch_1 p
                                                                                                          end eq_refl) =
     BinNums.xH)
 then Some BinNums.N0
 else
  Some
    (BinNums.Npos
       (BinPos.Pos.pred
          (let program_branch_0 := fun _ : BinNums.N0 = x => BinNums.xH in
           let program_branch_1 := fun (p : BinNums.positive) (_ : BinNums.Npos p = x) => BinPos.Pos.succ p in match x as x' return (x' = x -> BinNums.positive) with
                                                                                                               | BinNums.N0 => program_branch_0
                                                                                                               | BinNums.Npos p => program_branch_1 p
                                                                                                               end eq_refl)))) =
Some x
