countable.Z_countable_obligation_1 :
forall x : BinNums.Z,
Some
  (let program_branch_0 :=
     fun
       _ : BinNums.xH =
           (let program_branch_0 := fun _ : BinNums.Z0 = x => BinNums.xH in
            let program_branch_1 := fun (p : BinNums.positive) (_ : BinNums.Zpos p = x) => BinNums.xO p in
            let program_branch_2 := fun (p : BinNums.positive) (_ : BinNums.Zneg p = x) => BinNums.xI p in match x as x' return (x' = x -> BinNums.positive) with
                                                                                                           | BinNums.Z0 => program_branch_0
                                                                                                           | BinNums.Zpos p => program_branch_1 p
                                                                                                           | BinNums.Zneg p => program_branch_2 p
                                                                                                           end eq_refl) =>
     BinNums.Z0 in
   let program_branch_1 :=
     fun (p : BinNums.positive)
       (_ : BinNums.xO p =
            (let program_branch_1 := fun _ : BinNums.Z0 = x => BinNums.xH in
             let program_branch_2 := fun (p0 : BinNums.positive) (_ : BinNums.Zpos p0 = x) => BinNums.xO p0 in
             let program_branch_3 := fun (p0 : BinNums.positive) (_ : BinNums.Zneg p0 = x) => BinNums.xI p0 in match x as x' return (x' = x -> BinNums.positive) with
                                                                                                               | BinNums.Z0 => program_branch_1
                                                                                                               | BinNums.Zpos p0 => program_branch_2 p0
                                                                                                               | BinNums.Zneg p0 => program_branch_3 p0
                                                                                                               end eq_refl)) =>
     BinNums.Zpos p in
   let program_branch_2 :=
     fun (p : BinNums.positive)
       (_ : BinNums.xI p =
            (let program_branch_2 := fun _ : BinNums.Z0 = x => BinNums.xH in
             let program_branch_3 := fun (p0 : BinNums.positive) (_ : BinNums.Zpos p0 = x) => BinNums.xO p0 in
             let program_branch_4 := fun (p0 : BinNums.positive) (_ : BinNums.Zneg p0 = x) => BinNums.xI p0 in match x as x' return (x' = x -> BinNums.positive) with
                                                                                                               | BinNums.Z0 => program_branch_2
                                                                                                               | BinNums.Zpos p0 => program_branch_3 p0
                                                                                                               | BinNums.Zneg p0 => program_branch_4 p0
                                                                                                               end eq_refl)) =>
     BinNums.Zneg p in
   match
     (let program_branch_3 := fun _ : BinNums.Z0 = x => BinNums.xH in
      let program_branch_4 := fun (p : BinNums.positive) (_ : BinNums.Zpos p = x) => BinNums.xO p in
      let program_branch_5 := fun (p : BinNums.positive) (_ : BinNums.Zneg p = x) => BinNums.xI p in match x as x' return (x' = x -> BinNums.positive) with
                                                                                                     | BinNums.Z0 => program_branch_3
                                                                                                     | BinNums.Zpos p => program_branch_4 p
                                                                                                     | BinNums.Zneg p => program_branch_5 p
                                                                                                     end eq_refl)
     as p'
     return
       (p' =
        (let program_branch_3 := fun _ : BinNums.Z0 = x => BinNums.xH in
         let program_branch_4 := fun (p : BinNums.positive) (_ : BinNums.Zpos p = x) => BinNums.xO p in
         let program_branch_5 := fun (p : BinNums.positive) (_ : BinNums.Zneg p = x) => BinNums.xI p in match x as x' return (x' = x -> BinNums.positive) with
                                                                                                        | BinNums.Z0 => program_branch_3
                                                                                                        | BinNums.Zpos p => program_branch_4 p
                                                                                                        | BinNums.Zneg p => program_branch_5 p
                                                                                                        end eq_refl) ->
        BinNums.Z)
   with
   | BinNums.xI p => program_branch_2 p
   | BinNums.xO p => program_branch_1 p
   | BinNums.xH => program_branch_0
   end eq_refl) =
Some x
