(forall y1 y2 : B, base.equiv y1 y2 <-> base.equiv (g y1) (g y2)) -> (forall (n : stepindex.sidx_car) (y1 y2 : B), ofe.dist n y1 y2 <-> ofe.dist n (g y1) (g y2)) -> ofe.OfeMixin B
cmra.iso_cmra_mixin_restrict_validity :
forall (SI : stepindex.sidx) (A : cmra.cmra) (B : ofe.ofe) (PCore0 : cmra.PCore (ofe.ofe_car B)) (Op0 : cmra.Op (ofe.ofe_car B)) (Valid0 : cmra.Valid (ofe.ofe_car B)) (ValidN0 : cmra.ValidN (ofe.ofe_car B)) (f : cmra.cmra_car A -> ofe.ofe_car B) (g : ofe.ofe_car B -> cmra.cmra_car A),
(forall (n : stepindex.sidx_car) (y1 y2 : ofe.ofe_car B), ofe.dist n y1 y2 <-> ofe.dist n (g y1) (g y2)) ->
(forall x : cmra.cmra_car A, base.equiv (g (f x)) x) ->
(forall y : ofe.ofe_car B, base.equiv (cmra.pcore (g y)) (base.fmap g (cmra.pcore y))) ->
(forall y1 y2 : ofe.ofe_car B, base.equiv (g (cmra.op y1 y2)) (cmra.op (g y1) (g y2))) ->
(forall (n : stepindex.sidx_car) (y : ofe.ofe_car B), cmra.validN n y -> cmra.validN n (g y)) ->
(forall n : stepindex.sidx_car, Morphisms.Proper (Morphisms.respectful (ofe.dist n) Basics.impl) (cmra.validN n)) ->
(forall y : ofe.ofe_car B, cmra.valid y <-> (forall n : stepindex.sidx_car, cmra.validN n y)) ->
(forall (n m : stepindex.sidx_car) (y : ofe.ofe_car B), cmra.validN n y -> stepindex.sidx_le m n -> cmra.validN m y) -> (forall (n : stepindex.sidx_car) (y1 y2 : ofe.ofe_car B), cmra.validN n (cmra.op y1 y2) -> cmra.validN n y1) -> cmra.CmraMixin (ofe.ofe_car B)
