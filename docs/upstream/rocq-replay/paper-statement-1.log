 gmap.gmap_dep_lookup i mt = None ->
 (forall (j : BinNums.positive) (A' B : Type) (f : BinNums.positive -> A' -> B -> B) (g : A -> A') (b : B) (x' : A'),
  gmap.gmap_dep_fold f j b (gmap.gmap_dep_partial_alter (fun _ : option A' => Some x') i p (gmap.gmap_dep_fmap g mt)) = f (numbers.Pos.reverse_go i j) x' (gmap.gmap_dep_fold f j b (gmap.gmap_dep_fmap g mt))) ->
