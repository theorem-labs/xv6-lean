BinInt.Z.pow_1_l :
forall a : BinNums.Z, BinInt.Z.le BinNums.Z0 a -> BinInt.Z.pow (BinNums.Zpos BinNums.xH) a = BinNums.Zpos BinNums.xH
BinInt.Z.pow_0_r :
forall n : BinNums.Z, BinInt.Z.pow n BinNums.Z0 = BinNums.Zpos BinNums.xH
list_misc.positives_unflatten_go_app :
forall (p suffix : BinNums.positive) (xs : list BinNums.positive) (acc : BinNums.positive), list_misc.positives_unflatten_go (numbers.Pos.app suffix (numbers.Pos.reverse (numbers.Pos.dup p))) xs acc = list_misc.positives_unflatten_go suffix xs (numbers.Pos.app acc p)
list_misc.positives_unflatten_flatten_go :
forall (suffix : BinNums.positive) (xs acc : list BinNums.positive), list_misc.positives_unflatten_go (numbers.Pos.app suffix (list_misc.positives_flatten_go xs BinNums.xH)) acc BinNums.xH = list_misc.positives_unflatten_go suffix (xs ++ acc) BinNums.xH
list_misc.positives_unflatten_flatten :
forall xs : list BinNums.positive, list_misc.positives_unflatten (list_misc.positives_flatten xs) = Some xs
list_misc.positives_flatten_go_app :
forall (xs : list BinNums.positive) (acc : BinNums.positive), list_misc.positives_flatten_go xs acc = numbers.Pos.app acc (list_misc.positives_flatten_go xs BinNums.xH)
Znat.positive_nat_Z :
forall p : BinNums.positive, BinInt.Z.of_nat (BinPos.Pos.to_nat p) = BinNums.Zpos p
Znat.positive_nat_N :
forall p : BinNums.positive, BinNat.N.of_nat (BinPos.Pos.to_nat p) = BinNums.Npos p
numbers.pos_to_Qp_obligation_1 :
forall n : BinNums.positive, Qcanon.Qclt (Qcanon.Q2Qc {| QArith_base.Qnum := BinNums.Z0; QArith_base.Qden := BinNums.xH |}) (numbers.Qc_of_Z (BinNums.Zpos n))
BinInt.Z.pos_sub_spec :
forall p q : BinNums.positive, BinInt.Z.pos_sub p q = match BinPos.Pos.compare p q with
                                                      | Eq => BinNums.Z0
                                                      | Lt => BinNums.Zneg (BinPos.Pos.sub q p)
                                                      | Gt => BinNums.Zpos (BinPos.Pos.sub p q)
                                                      end
BinInt.Z.pos_sub_opp :
forall p q : BinNums.positive, BinInt.Z.opp (BinInt.Z.pos_sub p q) = BinInt.Z.pos_sub q p
BinInt.Z.pos_sub_lt :
