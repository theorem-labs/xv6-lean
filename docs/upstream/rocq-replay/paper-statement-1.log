BinPos.Pos.iter_add :
forall (p q : BinNums.positive) (A : Type) (f : A -> A) (x : A), BinPos.Pos.iter f x (BinPos.Pos.add p q) = BinPos.Pos.iter f (BinPos.Pos.iter f x q) p
