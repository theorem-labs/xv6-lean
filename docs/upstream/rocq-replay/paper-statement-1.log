forall (n : BinNums.Z) (x : Values.mword n),
match n as n0 return (option (Values.mword n0)) with
| BinNums.Z0 => countable.decode (match n as n0 return (Values.mword n0 -> BinNums.positive) with
                                  | BinNums.Z0 => countable.encode
                                  | BinNums.Zpos p => countable.encode
                                  | BinNums.Zneg p => countable.encode
                                  end x)
| BinNums.Zpos p0 => countable.decode (match n as n0 return (Values.mword n0 -> BinNums.positive) with
                                       | BinNums.Z0 => countable.encode
                                       | BinNums.Zpos p => countable.encode
                                       | BinNums.Zneg p => countable.encode
                                       end x)
| BinNums.Zneg p0 => countable.decode (match n as n0 return (Values.mword n0 -> BinNums.positive) with
                                       | BinNums.Z0 => countable.encode
                                       | BinNums.Zpos p => countable.encode
                                       | BinNums.Zneg p => countable.encode
                                       end x)
end = Some x
