(forall (env : Env) (d : Term'), eval' env d \/ ~ eval' env d) ->
(forall t : Term', unsat t = true -> forall env : Env, eval' env t -> False) ->
(forall t t' u : Term', deduce t t' = Some u -> forall env : Env, eval' env t -> eval' env t' -> eval' env u) ->
forall (eval : Env -> forall k : Tauto.kind, Term -> Tauto.rtyp k) (k : Tauto.kind) (f1 f2 : Tauto.GFormula k),
(forall (pol : bool) (env : Env), Tauto.eval_cnf eval' env (Tauto.xcnf unsat deduce normalise negate pol f1) -> Tauto.hold k (Tauto.eval_f Tauto.e_rtyp (eval env) (if pol then f1 else Tauto.NOT f1))) ->
(forall (pol : bool) (env : Env), Tauto.eval_cnf eval' env (Tauto.xcnf unsat deduce normalise negate pol f2) -> Tauto.hold k (Tauto.eval_f Tauto.e_rtyp (eval env) (if pol then f2 else Tauto.NOT f2))) ->
forall (pol : bool) (env : Env), Tauto.eval_cnf eval' env (Tauto.xcnf unsat deduce normalise negate pol (Tauto.IFF f1 f2)) -> Tauto.hold k (Tauto.eval_f Tauto.e_rtyp (eval env) (if pol then Tauto.IFF f1 f2 else Tauto.NOT (Tauto.IFF f1 f2)))
Tauto.xcnf_correct :
forall (Env Term Term' Annot : Type) (unsat : Term' -> bool) (deduce : Term' -> Term' -> option Term') (normalise negate : Term -> Annot -> Tauto.cnf Term' Annot) (eval' : Env -> Term' -> Prop),
(forall (env : Env) (d : Term'), eval' env d \/ ~ eval' env d) ->
(forall t : Term', unsat t = true -> forall env : Env, eval' env t -> False) ->
(forall t t' u : Term', deduce t t' = Some u -> forall env : Env, eval' env t -> eval' env t' -> eval' env u) ->
forall eval : Env -> forall k : Tauto.kind, Term -> Tauto.rtyp k,
(forall (env : Env) (b : Tauto.kind) (t : Term) (tg : Annot), Tauto.eval_cnf eval' env (normalise t tg) -> Tauto.hold b (eval env b t)) ->
(forall (env : Env) (b : Tauto.kind) (t : Term) (tg : Annot), Tauto.eval_cnf eval' env (negate t tg) -> Tauto.hold b (Tauto.eNOT b (eval env b t))) ->
forall (k : Tauto.kind) (f : Tauto.GFormula k) (pol : bool) (env : Env), Tauto.eval_cnf eval' env (Tauto.xcnf unsat deduce normalise negate pol f) -> Tauto.hold k (Tauto.eval_f Tauto.e_rtyp (eval env) (if pol then f else Tauto.NOT f))
