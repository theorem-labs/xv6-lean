| Some pe1' => Ring_polynom.Psub cO cadd csub copp ceqb (Ring_polynom.norm_aux cO cI cadd cmul csub copp ceqb pe2) (Ring_polynom.norm_aux cO cI cadd cmul csub copp ceqb pe1')
