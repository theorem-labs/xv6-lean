view.view_valid_instance :
forall (SI : stepindex.sidx) (A : ofe.ofe) (B : cmra.ucmra) (rel : view.view_rel A B), cmra.Valid (view.view (view.view_rel_holds rel))
view.view_valid_eq :
forall (SI : stepindex.sidx) (A : ofe.ofe) (B : cmra.ucmra) (rel : view.view_rel A B),
cmra.valid =
(fun x : view.view (view.view_rel_holds rel) =>
 match view.view_auth_proj x with
 | Some (dq, ag) => cmra.valid dq /\ (forall n : stepindex.sidx_car, exists a : ofe.ofe_car A, ofe.dist n ag (agree.to_agree a) /\ view.view_rel_holds rel n a (view.view_frag_proj x))
 | None => forall n : stepindex.sidx_car, exists a : ofe.ofe_car A, view.view_rel_holds rel n a (view.view_frag_proj x)
 end)
view.view_validN_instance :
forall (SI : stepindex.sidx) (A : ofe.ofe) (B : cmra.ucmra) (rel : view.view_rel A B), cmra.ValidN (view.view (view.view_rel_holds rel))
view.view_validN_eq :
forall (SI : stepindex.sidx) (A : ofe.ofe) (B : cmra.ucmra) (rel : view.view_rel A B),
cmra.validN =
(fun (n : stepindex.sidx_car) (x : view.view (view.view_rel_holds rel)) =>
 match view.view_auth_proj x with
 | Some (dq, ag) => cmra.validN n dq /\ (exists a : ofe.ofe_car A, ofe.dist n ag (agree.to_agree a) /\ view.view_rel_holds rel n a (view.view_frag_proj x))
 | None => exists a : ofe.ofe_car A, view.view_rel_holds rel n a (view.view_frag_proj x)
 end)
view.view_rel_validN :
forall (SI : stepindex.sidx) (A : ofe.ofe) (B : cmra.ucmra) (v : view.view_rel A B) (n : stepindex.sidx_car) (a : ofe.ofe_car A) (b : cmra.ucmra_car B), view.view_rel_holds v n a b -> cmra.validN n b
view.view_rel_unit :
forall (SI : stepindex.sidx) (A : ofe.ofe) (B : cmra.ucmra) (v : view.view_rel A B) (n : stepindex.sidx_car), exists a : ofe.ofe_car A, view.view_rel_holds v n a cmra.ε
view.view_rel_mono :
forall (SI : stepindex.sidx) (A : ofe.ofe) (B : cmra.ucmra) (v : view.view_rel A B) (n1 n2 : stepindex.sidx_car) (a1 a2 : ofe.ofe_car A) (b1 b2 : cmra.ucmra_car B),
view.view_rel_holds v n1 a1 b1 -> ofe.dist n2 a1 a2 -> cmra.includedN n2 b2 b1 -> stepindex.sidx_le n2 n1 -> view.view_rel_holds v n2 a2 b2
view.view_rel_holds :
forall (SI : stepindex.sidx) (A : ofe.ofe) (B : cmra.ucmra), view.view_rel A B -> stepindex.sidx_car -> ofe.ofe_car A -> cmra.ucmra_car B -> Prop
view.view_pcore_instance :
