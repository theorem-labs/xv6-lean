Znumtheory.extgcd_subproof :
forall a b : BinNums.Z,
True ->
BinInt.Z.le BinNums.Z0 (BinInt.Z.abs a) /\
BinInt.Z.le BinNums.Z0 (BinInt.Z.abs b) /\ BinInt.Z.abs a = BinInt.Z.add (BinInt.Z.mul (BinInt.Z.sgn a) a) (BinInt.Z.mul BinNums.Z0 b) /\ BinInt.Z.abs b = BinInt.Z.add (BinInt.Z.mul BinNums.Z0 a) (BinInt.Z.mul (BinInt.Z.sgn b) b) /\ BinInt.Z.gcd (BinInt.Z.abs a) (BinInt.Z.abs b) = BinInt.Z.gcd a b
Znumtheory.extgcd_rec_subproof1 :
forall a b r1 : BinNums.Z,
(forall y : BinNums.Z,
 (fun n m : BinNums.Z => BinInt.Z.le BinNums.Z0 n /\ BinInt.Z.lt n m) y r1 ->
 (fun x : BinNums.Z =>
  forall x0 x1 x2 x3 x4 : BinNums.Z,
  (True -> BinInt.Z.le BinNums.Z0 x /\ BinInt.Z.le BinNums.Z0 x2 /\ x = BinInt.Z.add (BinInt.Z.mul x0 a) (BinInt.Z.mul x1 b) /\ x2 = BinInt.Z.add (BinInt.Z.mul x3 a) (BinInt.Z.mul x4 b) /\ BinInt.Z.gcd x x2 = BinInt.Z.gcd a b) ->
  {'(u, v, d) : BinNums.Z * BinNums.Z * BinNums.Z | True -> BinInt.Z.add (BinInt.Z.mul u a) (BinInt.Z.mul v b) = d /\ d = BinInt.Z.gcd a b}) y) ->
forall u1 v1 r2 u2 v2 : BinNums.Z,
(True -> BinInt.Z.le BinNums.Z0 r1 /\ BinInt.Z.le BinNums.Z0 r2 /\ r1 = BinInt.Z.add (BinInt.Z.mul u1 a) (BinInt.Z.mul v1 b) /\ r2 = BinInt.Z.add (BinInt.Z.mul u2 a) (BinInt.Z.mul v2 b) /\ BinInt.Z.gcd r1 r2 = BinInt.Z.gcd a b) ->
r1 <> BinNums.Z0 ->
let q := BinInt.Z.div r2 r1 in
True ->
BinInt.Z.le BinNums.Z0 (BinInt.Z.sub r2 (BinInt.Z.mul q r1)) /\
BinInt.Z.le BinNums.Z0 r1 /\
BinInt.Z.sub r2 (BinInt.Z.mul q r1) = BinInt.Z.add (BinInt.Z.mul (BinInt.Z.sub u2 (BinInt.Z.mul q u1)) a) (BinInt.Z.mul (BinInt.Z.sub v2 (BinInt.Z.mul q v1)) b) /\ r1 = BinInt.Z.add (BinInt.Z.mul u1 a) (BinInt.Z.mul v1 b) /\ BinInt.Z.gcd (BinInt.Z.sub r2 (BinInt.Z.mul q r1)) r1 = BinInt.Z.gcd a b
Znumtheory.extgcd_rec_subproof0 :
forall a b r1 u1 v1 r2 u2 v2 : BinNums.Z,
(True -> BinInt.Z.le BinNums.Z0 r1 /\ BinInt.Z.le BinNums.Z0 r2 /\ r1 = BinInt.Z.add (BinInt.Z.mul u1 a) (BinInt.Z.mul v1 b) /\ r2 = BinInt.Z.add (BinInt.Z.mul u2 a) (BinInt.Z.mul v2 b) /\ BinInt.Z.gcd r1 r2 = BinInt.Z.gcd a b) ->
r1 <> BinNums.Z0 -> let q := BinInt.Z.div r2 r1 in BinInt.Z.le BinNums.Z0 (BinInt.Z.sub r2 (BinInt.Z.mul q r1)) /\ BinInt.Z.lt (BinInt.Z.sub r2 (BinInt.Z.mul q r1)) r1
Znumtheory.extgcd_rec_subproof :
forall a b r1 : BinNums.Z,
(forall y : BinNums.Z,
 (fun n m : BinNums.Z => BinInt.Z.le BinNums.Z0 n /\ BinInt.Z.lt n m) y r1 ->
 (fun x : BinNums.Z =>
  forall x0 x1 x2 x3 x4 : BinNums.Z,
  (True -> BinInt.Z.le BinNums.Z0 x /\ BinInt.Z.le BinNums.Z0 x2 /\ x = BinInt.Z.add (BinInt.Z.mul x0 a) (BinInt.Z.mul x1 b) /\ x2 = BinInt.Z.add (BinInt.Z.mul x3 a) (BinInt.Z.mul x4 b) /\ BinInt.Z.gcd x x2 = BinInt.Z.gcd a b) ->
  {'(u, v, d) : BinNums.Z * BinNums.Z * BinNums.Z | True -> BinInt.Z.add (BinInt.Z.mul u a) (BinInt.Z.mul v b) = d /\ d = BinInt.Z.gcd a b}) y) ->
forall u1 v1 r2 u2 v2 : BinNums.Z,
(True -> BinInt.Z.le BinNums.Z0 r1 /\ BinInt.Z.le BinNums.Z0 r2 /\ r1 = BinInt.Z.add (BinInt.Z.mul u1 a) (BinInt.Z.mul v1 b) /\ r2 = BinInt.Z.add (BinInt.Z.mul u2 a) (BinInt.Z.mul v2 b) /\ BinInt.Z.gcd r1 r2 = BinInt.Z.gcd a b) ->
r1 = BinNums.Z0 -> True -> BinInt.Z.add (BinInt.Z.mul u2 a) (BinInt.Z.mul v2 b) = r2 /\ r2 = BinInt.Z.gcd a b
