RingMicromega.cltb_sound :
forall (R : Type) (rO rI : R) (rplus rtimes rminus : R -> R -> R) (ropp : R -> R) (req rle rlt : R -> R -> Prop),
OrderedRing.SOR rO rI rplus rtimes rminus ropp req rle rlt ->
forall (C : Type) (cO cI : C) (cplus ctimes cminus : C -> C -> C) (copp : C -> C) (ceqb cleb : C -> C -> bool) (phi : C -> R) (E : Type) (pow_phi : BinNums.N -> E) (rpow : R -> E -> R),
RingMicromega.SORaddon rO rI rplus rtimes rminus ropp req rle cO cI cplus ctimes cminus copp ceqb cleb phi pow_phi rpow -> forall x y : C, RingMicromega.cltb ceqb cleb x y = true -> rlt (phi x) (phi y)
RingMicromega.cleb_sound :
forall (R : Type) (rO rI : R) (rplus rtimes rminus : R -> R -> R) (ropp : R -> R) (req rle : R -> R -> Prop) (C : Type) (cO cI : C) (cplus ctimes cminus : C -> C -> C) (copp : C -> C) (ceqb cleb : C -> C -> bool) (phi : C -> R) (E : Type) (pow_phi : BinNums.N -> E) (rpow : R -> E -> R),
RingMicromega.SORaddon rO rI rplus rtimes rminus ropp req rle cO cI cplus ctimes cminus copp ceqb cleb phi pow_phi rpow -> forall x y : C, cleb x y = true -> rle (phi x) (phi y)
RingMicromega.checker_nf_sound :
forall (R : Type) (rO rI : R) (rplus rtimes rminus : R -> R -> R) (ropp : R -> R) (req rle rlt : R -> R -> Prop),
OrderedRing.SOR rO rI rplus rtimes rminus ropp req rle rlt ->
forall (C : Type) (cO cI : C) (cplus ctimes cminus : C -> C -> C) (copp : C -> C) (ceqb cleb : C -> C -> bool) (phi : C -> R) (E : Type) (pow_phi : BinNums.N -> E) (rpow : R -> E -> R),
RingMicromega.SORaddon rO rI rplus rtimes rminus ropp req rle cO cI cplus ctimes cminus copp ceqb cleb phi pow_phi rpow ->
forall (l : list (RingMicromega.NFormula C)) (cm : RingMicromega.Psatz C), RingMicromega.check_normalised_formulas cO cI cplus ctimes ceqb cleb l cm = true -> forall env : RingMicromega.PolEnv R, Refl.make_impl (RingMicromega.eval_nformula rO rplus rtimes req rle rlt phi env) l False
RingMicromega.check_inconsistent_sound :
forall (R : Type) (rO rI : R) (rplus rtimes rminus : R -> R -> R) (ropp : R -> R) (req rle rlt : R -> R -> Prop),
OrderedRing.SOR rO rI rplus rtimes rminus ropp req rle rlt ->
forall (C : Type) (cO cI : C) (cplus ctimes cminus : C -> C -> C) (copp : C -> C) (ceqb cleb : C -> C -> bool) (phi : C -> R) (E : Type) (pow_phi : BinNums.N -> E) (rpow : R -> E -> R),
RingMicromega.SORaddon rO rI rplus rtimes rminus ropp req rle cO cI cplus ctimes cminus copp ceqb cleb phi pow_phi rpow ->
forall (p : RingMicromega.PolC C) (op : RingMicromega.Op1), RingMicromega.check_inconsistent cO ceqb cleb (p, op) = true -> forall env : RingMicromega.PolEnv R, ~ RingMicromega.eval_op1 rO req rle rlt op (RingMicromega.eval_pol rplus rtimes phi env p)
Ring_polynom.ceqb_spec :
