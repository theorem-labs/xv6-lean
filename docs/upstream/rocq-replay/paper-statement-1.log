a = BinInt.Z.add l (BinInt.Z.mul (BinInt.Z.add (BinInt.Z.b2z a0) (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) h)) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) n)) -> BinInt.Z.testbit a n = a0
