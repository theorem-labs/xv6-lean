forall n m : BinNums.Z, BinInt.Z.lt m BinNums.Z0 -> BinInt.Z.pow n m = BinNums.Z0
BinInt.Z.pow_lt_mono_r_iff :
forall a b c : BinNums.Z, BinInt.Z.lt (BinNums.Zpos BinNums.xH) a -> BinInt.Z.le BinNums.Z0 c -> BinInt.Z.lt b c <-> BinInt.Z.lt (BinInt.Z.pow a b) (BinInt.Z.pow a c)
BinInt.Z.pow_lt_mono_r :
forall a b c : BinNums.Z, BinInt.Z.lt (BinNums.Zpos BinNums.xH) a -> BinInt.Z.le BinNums.Z0 c -> BinInt.Z.lt b c -> BinInt.Z.lt (BinInt.Z.pow a b) (BinInt.Z.pow a c)
BinInt.Z.pow_lt_mono_l :
forall a b c : BinNums.Z, BinInt.Z.lt BinNums.Z0 c -> BinInt.Z.le BinNums.Z0 a /\ BinInt.Z.lt a b -> BinInt.Z.lt (BinInt.Z.pow a c) (BinInt.Z.pow b c)
BinInt.Z.pow_le_mono_r_iff :
forall a b c : BinNums.Z, BinInt.Z.lt (BinNums.Zpos BinNums.xH) a -> BinInt.Z.le BinNums.Z0 c -> BinInt.Z.le b c <-> BinInt.Z.le (BinInt.Z.pow a b) (BinInt.Z.pow a c)
BinInt.Z.pow_le_mono_r :
forall a b c : BinNums.Z, BinInt.Z.lt BinNums.Z0 a -> BinInt.Z.le b c -> BinInt.Z.le (BinInt.Z.pow a b) (BinInt.Z.pow a c)
BinInt.Z.pow_gt_lin_r :
forall a b : BinNums.Z, BinInt.Z.lt (BinNums.Zpos BinNums.xH) a -> BinInt.Z.le BinNums.Z0 b -> BinInt.Z.lt b (BinInt.Z.pow a b)
BinInt.Z.pow_gt_1 :
forall a b : BinNums.Z, BinInt.Z.lt (BinNums.Zpos BinNums.xH) a -> BinInt.Z.lt BinNums.Z0 b <-> BinInt.Z.lt (BinNums.Zpos BinNums.xH) (BinInt.Z.pow a b)
BinInt.Z.pow_eq_0 :
forall a b : BinNums.Z, BinInt.Z.le BinNums.Z0 b -> BinInt.Z.pow a b = BinNums.Z0 -> a = BinNums.Z0
BinInt.Z.pow_add_r :
forall a b c : BinNums.Z, BinInt.Z.le BinNums.Z0 b -> BinInt.Z.le BinNums.Z0 c -> BinInt.Z.pow a (BinInt.Z.add b c) = BinInt.Z.mul (BinInt.Z.pow a b) (BinInt.Z.pow a c)
