Ring_theory.ring_morph rO rI radd rmul rsub ropp req cO cI cadd cmul csub copp ceqb phi ->
forall (Cpow : Type) (Cp_phi : BinNums.N -> Cpow) (rpow : R -> Cpow -> R),
Ring_theory.power_theory rI rmul req Cp_phi rpow ->
forall cdiv : C -> C -> C * C,
Ring_theory.div_theory req cadd cmul phi cdiv ->
forall get_sign : C -> option C,
Ring_theory.sign_theory copp ceqb get_sign ->
forall (n : nat) (lH : list (Ring_polynom.PExpr C * Ring_polynom.PExpr C)) (l : list R),
Ring_polynom.interp_PElist rO rI radd rmul rsub ropp req phi Cp_phi rpow l lH ->
forall lmp : list (C * Ring_polynom.Mon * Ring_polynom.Pol C),
Ring_polynom.mk_monpol_list cO cI cadd cmul csub copp ceqb cdiv lH = lmp ->
forall (pe : Ring_polynom.PExpr C) (npe : Ring_polynom.Pol C),
Ring_polynom.norm_subst cO cI cadd cmul csub copp ceqb cdiv n lmp pe = npe -> req (Ring_polynom.PEeval rO rI radd rmul rsub ropp phi Cp_phi rpow l pe) (Ring_polynom.Pphi_pow rO rI radd rmul rsub ropp cO cI ceqb phi Cp_phi rpow get_sign l npe)
