countable.option_countable_obligation_1 :
forall (A : Type) (EqDecision0 : base.RelDecision eq) (H : countable.Countable A) (x0 : option A),
(if
  base.decide
    ((let program_branch_0 := fun _ : None = x0 => BinNums.xH in let program_branch_1 := fun (x : A) (_ : Some x = x0) => BinPos.Pos.succ (countable.encode x) in match x0 as o' return (o' = x0 -> BinNums.positive) with
                                                                                                                                                                  | Some x => program_branch_1 x
                                                                                                                                                                  | None => program_branch_0
                                                                                                                                                                  end eq_refl) =
     BinNums.xH)
 then Some None
 else
  base.fmap Some
    (countable.decode
       (BinPos.Pos.pred
          (let program_branch_0 := fun _ : None = x0 => BinNums.xH in let program_branch_1 := fun (x : A) (_ : Some x = x0) => BinPos.Pos.succ (countable.encode x) in match x0 as o' return (o' = x0 -> BinNums.positive) with
                                                                                                                                                                       | Some x => program_branch_1 x
                                                                                                                                                                       | None => program_branch_0
                                                                                                                                                                       end eq_refl)))) =
Some x0
